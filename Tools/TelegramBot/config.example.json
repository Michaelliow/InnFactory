{
  // 复制本文件为 config.json 再填写。config.json 里有密钥：不要发到群里、不要提交到 git。

  // 1. 找 Telegram 的 @BotFather 发 /newbot 创建机器人，得到的 token 填这里
  "telegramBotToken": "",

  // 2. Claude API key（https://console.anthropic.com 创建，按用量计费，和 Claude 订阅分开）
  //    也可以不填这里，改用环境变量 ANTHROPIC_API_KEY
  "anthropicApiKey": "",

  // 3. 允许使用机器人的群 id（负数）。先留空启动，在群里 @机器人，它会告诉你群 id，填进来后重启。
  //    留空时机器人只回复 chat id，不会调用 Claude（防止陌生人用掉你的额度）。
  "allowedChatIds": [],

  "model": "claude-sonnet-5-5",
  // low / medium / high / xhigh / max：越高想得越深，也越慢越贵
  "effort": "low",
  // 每个群记住最近多少条消息当上下文（只在内存里，重启清空）
  "historyMessages": 80,
  "maxTokens": 16000,
  // 作为背景知识的项目文档（相对本文件所在目录）
  "projectDocs": [ "../../CLAUDE.md", "../../Docs/GDD.md" ]
}
